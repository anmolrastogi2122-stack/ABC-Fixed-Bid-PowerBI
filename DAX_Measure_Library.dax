// ============================================================================
// ABC Fixed Bid Program — DAX Measure Library
// Reference copy of the measures defined in ABC_Fixed_Bid_Portfolio.Dataset.
// Paste into Power BI Desktop's "New Measure" only if you need to recreate a
// measure by hand; the semantic model already ships with all of these.
// ============================================================================

// ---- Fact_Project ----------------------------------------------------------

Total Projects = COUNTROWS('Fact_Project')

Active Projects = CALCULATE([Total Projects], 'Fact_Project'[Status] = "Active")

Completed Projects = CALCULATE([Total Projects], 'Fact_Project'[Status] = "Completed")

Total Lifecycle Revenue = SUM('Fact_Project'[LifecycleRevenue])
Total Lifecycle Cost = SUM('Fact_Project'[LifecycleCost])
Lifecycle Margin % =
    VAR Rev = [Total Lifecycle Revenue]
    VAR Cost = [Total Lifecycle Cost]
    RETURN DIVIDE(Rev - Cost, Rev, 0)

Total Actual Revenue = SUM('Fact_Project'[ActualRevenue])
Total Actual Cost = SUM('Fact_Project'[ActualCost])
Actual Margin % =
    VAR Rev = [Total Actual Revenue]
    VAR Cost = [Total Actual Cost]
    RETURN DIVIDE(Rev - Cost, Rev, 0)

Total YTD Revenue = SUM('Fact_Project'[YTDRevenue])
Total YTD Cost = SUM('Fact_Project'[YTDCost])
YTD Margin % =
    VAR Rev = [Total YTD Revenue]
    VAR Cost = [Total YTD Cost]
    RETURN DIVIDE(Rev - Cost, Rev, 0)

Total Future Revenue = SUM('Fact_Project'[FutureRevenue])
Total Future Cost = SUM('Fact_Project'[FutureCost])
Future Margin % =
    VAR Rev = [Total Future Revenue]
    VAR Cost = [Total Future Cost]
    RETURN DIVIDE(Rev - Cost, Rev, 0)

// Disconnected-table slicer pattern: 'Dim_MarginBasis'[MarginBasis] drives which
// revenue/cost basis (Lifecycle / YTD / Actual / Future) the report shows.
Selected Margin Basis = SELECTEDVALUE('Dim_MarginBasis'[MarginBasis], "Actual")

Selected Revenue =
    SWITCH(
        [Selected Margin Basis],
        "Lifecycle", [Total Lifecycle Revenue],
        "YTD", [Total YTD Revenue],
        "Future", [Total Future Revenue],
        [Total Actual Revenue]
    )

Selected Cost =
    SWITCH(
        [Selected Margin Basis],
        "Lifecycle", [Total Lifecycle Cost],
        "YTD", [Total YTD Cost],
        "Future", [Total Future Cost],
        [Total Actual Cost]
    )

Selected Margin % =
    VAR Rev = [Selected Revenue]
    VAR Cost = [Selected Cost]
    RETURN DIVIDE(Rev - Cost, Rev, 0)

// ---- Fact_MonthlyTrend ------------------------------------------------------

Trend Revenue = SUM('Fact_MonthlyTrend'[Revenue])
Trend Cost = SUM('Fact_MonthlyTrend'[Cost])
Trend Margin % =
    VAR Rev = [Trend Revenue]
    VAR Cost = [Trend Cost]
    RETURN DIVIDE(Rev - Cost, Rev, 0)

// ---- Fact_BusinessUnit -------------------------------------------------------

Business Units = COUNTROWS('Fact_BusinessUnit')
Total BU Actual Revenue = SUM('Fact_BusinessUnit'[ActualRevenue])
Total BU Actual Cost = SUM('Fact_BusinessUnit'[ActualCost])

// ---- Fact_AssessmentKPI -------------------------------------------------------

Assessed Projects = COUNTROWS('Fact_AssessmentKPI')
Average Risk Score = AVERAGE('Fact_AssessmentKPI'[RiskScore])
Average Program Score = AVERAGE('Fact_AssessmentKPI'[NetProgramScore])
